          "name": "Criar usuário (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('emailUsuario', `teste.${Date.now()}@email.com`);",
                  "pm.collectionVariables.set('senhaUsuario', 'Senha@123');",
                  "pm.collectionVariables.set('cpfUsuario', pm.collectionVariables.get('cpfAleatorio'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const usuario = pm.response.json();",
                  "  pm.collectionVariables.set('idUsuario', usuario.id);",
                  "  pm.test('Resposta não expõe a senha', () => pm.expect(usuario).to.not.have.property('senha'));",
                  "  pm.test('E-mail gravado em minúsculas', () => pm.expect(usuario.email).to.eql(pm.collectionVariables.get('emailUsuario')));",
                  "  pm.test('dataCadastro preenchida pelo banco', () => pm.expect(usuario.dataCadastro).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Teste Postman\",\n  \"email\": \"{{emailUsuario}}\",\n  \"senha\": \"{{senhaUsuario}}\",\n  \"cpf\": \"{{cpfUsuario}}\",\n  \"dataNascimento\": \"1995-05-20\"\n}",
              "options": { "raw": { "language": "json" } }
